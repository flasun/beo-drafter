# Placeholders only. Do not put real keys in this repo, in chat, or in committed files.
# On a Sprite, use the connector path below. The operator pastes the live Ollama key into
# the Fly.io Sprites connector. The app never sends, logs, or stores that key.

OLLAMA_CONNECTION_ID=replace-me
OLLAMA_GATEWAY_BASE=https://api.sprites.dev/v1/gateway/ollama
OLLAMA_MODEL=replace-me

# Optional: full gateway chat URL instead of CONNECTION_ID + GATEWAY_BASE.
# OLLAMA_HOST=https://api.sprites.dev/v1/gateway/ollama/replace-me/api/chat

# Do not set OLLAMA_API_KEY on the Sprite. The connector gateway attaches the key.


# Demo server. Default bind is 127.0.0.1. A Sprite must set this (or pass --bind)
# so Fly can route the Sprite URL to port 8080.
# BEO_BIND=0.0.0.0

# Do not set this to 1 on a public Sprite URL. The HTTP form and /draft stay
# mock-only unless this is exactly 1.
# DEMO_ALLOW_OLLAMA=1
